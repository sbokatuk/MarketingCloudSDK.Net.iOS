<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MarketingCloudSDK.Net.iOS.Example.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="12">

            <Label Text="MarketingCloudSDK.Net.iOS"
                   FontSize="24" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Drives the raw MobilePush binding. Enter your own MobilePush app credentials - nothing is baked in, nothing is stored. Push delivery additionally needs an APNs-entitled provisioning profile; without it initialization still proceeds and the SDK reports its state."
                   FontSize="13" />

            <Entry x:Name="AppIdEntry" Placeholder="Application id" />
            <Entry x:Name="AccessTokenEntry" Placeholder="Access token" />
            <Entry x:Name="ServerUrlEntry" Placeholder="Tenant endpoint URL (https://...marketingcloudapis.com/)" />
            <Entry x:Name="MidEntry" Placeholder="MID" Keyboard="Numeric" />

            <Button x:Name="InitializeButton"
                    Text="Initialize the SDK"
                    Clicked="OnInitializeClicked" />

            <Label x:Name="StatusLabel" Text="Not initialized." FontAttributes="Bold" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

            <Entry x:Name="ContactKeyEntry"
                   Placeholder="Contact key"
                   IsEnabled="False" />
            <Button x:Name="ContactKeyButton"
                    Text="Set contact key"
                    IsEnabled="False"
                    Clicked="OnSetContactKeyClicked" />

            <Button x:Name="StateButton"
                    Text="Show SDK state"
                    IsEnabled="False"
                    Clicked="OnShowStateClicked" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

            <Label Text="Log" FontAttributes="Bold" />
            <Label x:Name="LogLabel" FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
