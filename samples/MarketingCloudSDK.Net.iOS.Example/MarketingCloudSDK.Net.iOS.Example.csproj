<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		  Which of the package's bands the sample is built for. One at a time rather than all
		  three at once: the target framework has to be one the SDK on the machine understands,
		  and net10.0-ios26.0 needs the .NET 10 band while the repository's global.json pins
		  .NET 9. Multi-targeting them together fails at restore, which evaluates every target
		  framework whatever the build was asked for. Pass -p:SfmcSdkBand=net10 from a directory
		  whose global.json selects the .NET 10 SDK to build that band.
		-->
		<SfmcSdkBand Condition=" '$(SfmcSdkBand)' == '' ">net9</SfmcSdkBand>
		<TargetFrameworks Condition=" '$(SfmcSdkBand)' == 'net8' ">net8.0-ios18.0</TargetFrameworks>
		<TargetFrameworks Condition=" '$(SfmcSdkBand)' == 'net9' ">net9.0-ios18.0</TargetFrameworks>
		<TargetFrameworks Condition=" '$(SfmcSdkBand)' == 'net10' ">net10.0-ios26.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>MarketingCloudSDK.Net.iOS.Example</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>MarketingCloudSDK.Net.iOS.Example</ApplicationTitle>
		<ApplicationId>com.sbokatuk.mcsdknet.example</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
	</ItemGroup>

	<!--
	  Resolved from ./artifacts through the local feed in the repository's NuGet.config, not from
	  nuget.org, so the sample always exercises your local build. Run ./build/BuildNugets.sh first.
	  Pass -p:SfmcPackageVersion=4.0.1.2-rc.1 to point it at a specific build.
	-->
	<PropertyGroup>
		<SfmcPackageVersion Condition=" '$(SfmcPackageVersion)' == '' ">$(VersionPrefix)</SfmcPackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MarketingCloudSDK.Net.iOS" Version="$(SfmcPackageVersion)" />
	</ItemGroup>

</Project>
